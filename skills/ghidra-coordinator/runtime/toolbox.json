        "darwin-arm64",
        "darwin-x64",
        "linux-x64",
        "win32-x64"
      ],
      "dependencies": [
        "private Ghidra",
        "private JDK",
        "packaged Ghidra bridge"
      ],
      "workflowCommands": [
        "ghidra open",
        "ghidra functions",
        "ghidra strings",
        "ghidra merge",
        "ghidra refresh",
        "ghidra debugger"
