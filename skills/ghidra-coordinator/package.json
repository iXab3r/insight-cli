    "@modelcontextprotocol/sdk": "1.32.1",
    "tar": "7.5.22",
    "yauzl": "3.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iXab3r/insight-cli.git",
