{
  "name": "@eyeauras/insight-cli",
  "version": "0.2.0",
  "type": "module",
  "description": "Agent-facing durable sessions and isolated Ghidra research contexts",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "insight-cli": "./dist/src/bin.js"
  },
