  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node ../../scripts/prepare-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@eyeauras/cli-factory": "https://raw.githubusercontent.com/iXab3r/insight-cli/246048487ede0610e6171545875956f7df72ebfe/vendor/factory-core-13b01dc.tgz",
