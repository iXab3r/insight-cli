  "findings": [
    {
      "id": "A1",
      "type": "observed product architecture",
      "summary": "Active ResearchBackend persists snapshots/scalars rather than native context checkout identity; merge and refresh have coordinator semantic authority"
    },
    {
      "id": "A2",
      "type": "source-based migration risk; no new current-loss reproduction",
      "summary": "Low-level publisher manufactures broad change data, which is not a proven native checkout delta; mixing legacy and native ancestry requires explicit migration"
    },
    {
      "id": "A3",
      "type": "observed lifecycle/data path; size unmeasured",
      "summary": "Restore/capture/latest/candidate retain fresh projects and full exports; byte-level CAS does not deduplicate native working DBs"
    },
    {
      "id": "A4",
      "type": "implementation/evidence gap",
      "summary": "Native Update and general conflict resolution/headless paths are not integrated or accepted"
    },
    {
      "id": "A5",
      "type": "production/prototype authority mismatch",
      "summary": "Product separates reader/private workers/publisher, while proof gives every JVM the same writable account; credential-separated native checkout reuse remains unproved"
    },
    {
      "id": "A6",
      "type": "native constraints requiring lifecycle acceptance",
      "summary": "Exclusive structural edits, open-handle checkout retention, dirty-Update keep files and durable normal checkouts must be honored"
    },
    {
      "id": "A7",
      "type": "scope limitation; existing profile isolation is intentional",
      "summary": "Workspace namespaced target paths do not implicitly converge across independent profiles sharing one repository"
    }
  ],
